@startuml
!include ../common.iuml
left to right direction
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #333333
}
skinparam actorStyle default
skinparam packageStyle rectangle

actor "Prospective\nMember" as PM
actor Member as M
actor "Front Desk\nStaff" as FD
actor Instructor as I
actor Manager as MG
actor "Clock" <<time>> as C
actor "Payment\nGateway" <<system>> as PG

PM <|- M

rectangle "Gym & Fitness Club Membership System" {
  usecase "UC1 Sign Up for\nMembership" as UC1
  usecase "UC2 Book Class" as UC2
  usecase "UC3 Cancel Booking" as UC3
  usecase "UC11 View Invoices" as UC11
  usecase "UC4 Check In" as UC4
  usecase "UC5 Freeze /\nUnfreeze Membership" as UC5
  usecase "UC6 Cancel Membership" as UC6
  usecase "UC8 Record Attendance" as UC8
  usecase "UC10 Manage Class\nSchedule" as UC10
  usecase "UC9 Manage Plans\nand Prices" as UC9
  usecase "UC12 View Reports" as UC12
  usecase "UC7 Run Monthly Billing" as UC7
  usecase "UC13 Run Daily\nMembership Checks" as UC13
  usecase "UC14 Pay Arrears" as UC14

  usecase "Verify Membership\nStatus" as VMS
  usecase "Calculate Charges" as CC
  usecase "Promote from\nWaitlist" as PW
  usecase "Join Waitlist" as JW
  usecase "Apply Referral\nCredit" as ARC
  usecase "Apply Late-\nCancellation Fee" as LCF
  usecase "Apply No-Show\nPenalty" as NSP
  usecase "Charge Early-Exit\nFee" as EEF
}

PM -- UC1
M -- UC2
M -- UC3
M -- UC4
M -- UC5
M -- UC6
M -- UC11
FD -- UC4
FD -- UC5
FD -- UC6
C -- UC7
C -- UC13
M -- UC14
I -- UC8
I -- UC10
MG -- UC9
MG -- UC10
MG -- UC12

UC1 ..> CC : <<include>>
UC2 ..> VMS : <<include>>
UC4 ..> VMS : <<include>>
UC3 ..> PW : <<include>>
UC6 ..> CC : <<include>>
UC7 ..> CC : <<include>>
UC13 ..> CC : <<include>>

UC2 <.. JW : <<extend>>\n[class is full]
UC1 <.. ARC : <<extend>>\n[referral code given]
UC3 <.. LCF : <<extend>>\n[< 2 h before class]
UC8 <.. NSP : <<extend>>\n[member did not attend]
UC6 <.. EEF : <<extend>>\n[Annual plan, < 6 months]

UC1 -- PG
UC7 -- PG
UC6 -- PG
UC14 -- PG
@enduml
