@startuml
!include ../common.iuml
skinparam sequence {
  ParticipantBackgroundColor #F5F5F5
  ParticipantBorderColor #333333
  LifeLineBorderColor #888888
  GroupBackgroundColor #F5F5F5
}
skinparam responseMessageBelowArrow true
autoactivate off
hide footbox

actor "Member\n(Postman)" as M
participant ":BookingController" as C
participant ":BookingService" as S <<BookClassUseCase>>
participant ":GymClassRepository" as GR
participant ":MembershipRepository" as MR
participant ":Membership" as MS
participant ":MembershipState" as ST
participant ":GymClass" as G
participant ":Waitlist" as W

M -> C : POST /bookings\n{memberId, classId}
activate C
C -> S : book(memberId, classId)
activate S
note right of C
  The call passes through the
  Interceptor proxy (onBefore /
  onAfter, logged by LoggingInterceptor)
end note

S -> GR : findById(classId)
GR --> S : gymClass
S -> MR : findByMember(memberId)
MR --> S : membership

S -> MS : canBook(gymClass)
activate MS
MS -> ST : canBook()
ST --> MS : true / false
note right of ST
  Trial: under 2 bookings.
  Active: yes.
  Frozen, Lapsed, Cancelled: no
end note
MS --> S : allowed
deactivate MS

alt not allowed (state, suspension, plan or 5-booking limit)
  S --> C : RuleViolationException(reason)
  C --> M : 422 refused + reason
else allowed
  S -> G : isFull()
  G --> S : full
  alt space left
    S -> G : reserve(member)
    activate G
    create participant ":Booking" as B
    G -> B : <<create>>
    G --> S : booking
    deactivate G
    S -> GR : save(gymClass)
    S --> C : booked
    C --> M : 201 booked
  else class is full
    S -> W : add(member)
    W --> S : position
    S -> GR : save(gymClass)
    S --> C : waitlisted(position)
    C --> M : 200 waitlisted, position n
  end
end
deactivate S
deactivate C
@enduml
