@startuml
' Bootstrap draft, GenAI prompt #2. Render with PlantUML.
left to right direction
skinparam packageStyle rectangle
actor "Member" as M
actor "Prospective Member" as PM
actor "Front Desk Staff" as FD
actor "Instructor" as I
actor "Manager" as MG
actor "Payment Gateway" as PG <<system>>
actor "Clock" as CL <<time>>
PM --|> M

rectangle "Gym & Fitness Club Membership System" {
  usecase "Sign Up for Membership" as UC1
  usecase "Book Class" as UC2
  usecase "Cancel Booking" as UC3
  usecase "Check In" as UC4
  usecase "Freeze / Unfreeze Membership" as UC5
  usecase "Cancel Membership" as UC6
  usecase "Run Monthly Billing" as UC7
  usecase "Record Attendance" as UC8
  usecase "Manage Plans and Prices" as UC9
  usecase "Manage Class Schedule" as UC10
  usecase "View Invoices" as UC11
  usecase "View Reports" as UC12
  usecase "Calculate Charges" as CC
  usecase "Verify Membership Status" as VMS
  usecase "Join Waitlist" as JW
  usecase "Promote from Waitlist" as PW
  usecase "Apply Late-Cancellation Fee" as LCF
  usecase "Apply Referral Credit" as ARC
}

PM --> UC1
M --> UC2
M --> UC3
M --> UC4
M --> UC5
M --> UC6
M --> UC11
FD --> UC4
FD --> UC5
FD --> UC6
I --> UC8
I --> UC10
MG --> UC9
MG --> UC10
MG --> UC12
CL --> UC7
UC1 --> PG
UC7 --> PG

UC1 ..> CC : <<include>>
UC6 ..> CC : <<include>>
UC7 ..> CC : <<include>>
UC2 ..> VMS : <<include>>
UC4 ..> VMS : <<include>>
UC3 ..> PW : <<include>>
JW ..> UC2 : <<extend>>\n[class full]
LCF ..> UC3 : <<extend>>\n[< 2h before class]
ARC ..> UC1 : <<extend>>\n[referral code given]
@enduml
