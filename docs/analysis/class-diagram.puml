@startuml class-diagram
' Bootstrap draft, GenAI prompt #6 and #7. Report §6.
!include ../style.iuml

class Member {
  - name: String
  - email: String
  + isSuspended(): boolean
}
class Membership {
  - startDate: Date
  - state: State
  + canBook(): boolean
  + freeze(months: int)
}
abstract class Plan {
  # monthlyPrice: Money
  + priceFor(month): Money
}
class MonthlyPlan
class AnnualPlan
class StudentPlan

class GymClass {
  - capacity: int
  + isFull(): boolean
}
class Waitlist {
  + add(m: Member): int
  + promoteNext(): Member
}
class Booking {
  - status: Status
  + cancel()
}
class Invoice {
  + total(): Money
}
class Charge {
  - amount: Money
}
interface DiscountPolicy <<interface>> {
  + discountFor(amount): Money
}
class LoyaltyDiscount
interface PaymentGateway <<interface>> {
  + charge(m: Member, amount): boolean
}

Member "1" -- "1..*" Membership
Membership "*" --> "1" Plan
Plan <|-- MonthlyPlan
Plan <|-- AnnualPlan
Plan <|-- StudentPlan
Member "1" -- "*" Booking
Booking "*" --> "1" GymClass
GymClass *-- "1" Waitlist
Invoice o-- "1..*" Charge
Invoice ..> DiscountPolicy
DiscountPolicy <|.. LoyaltyDiscount
Membership ..> PaymentGateway

note bottom of DiscountPolicy
  pre: amount >= 0
  post: 0 <= result <= amount
end note
note bottom of PaymentGateway
  pre: amount > 0
  post: charged once, or not at all
end note
@enduml
